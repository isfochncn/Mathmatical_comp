# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# IDE
.idea/

# Excel lock files (temporary, created by Excel while a workbook is open)
~$*.xlsx

# Experiment outputs are regenerated by the CLI; keep them out of version control.
out/

# Scratch
*.tmp
tmp/

# PowerShell logs
*.log

# Never vendor bundled runtimes into results or scratch directories.
node_modules/
outputs/**/核验/*.png
outputs/**/*.inspect.ndjson
outputs/**/artifact_errors.jsonl
